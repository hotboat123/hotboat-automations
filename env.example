# Database Connection (Railway lo genera automáticamente)
DATABASE_URL=postgresql://user:password@localhost:5432/hotboat
DATABASE_AUTO_SETUP=false  # Cambia a true solo si quieres crear las tablas default automáticamente

# Puerto (Railway lo asigna automáticamente)
PORT=8080

# Telegram Bot (DESHABILITADO - usando WhatsApp)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=

# Email Configuration (SMTP)
EMAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_USE_SSL=false   # Usa SSL directo (465). Para TLS deja en false.
SMTP_USE_TLS=true    # STARTTLS (puerto 587). Ponlo en false si tu servidor no lo soporta.
# Compatibilidad con otros repos
EMAIL_USE_STL=
EMAIL_USE_SSL=
EMAIL_USE_TLS=
SMTP_MAX_RETRIES=3
SMTP_RETRY_BACKOFF=2
EMAIL_FROM=notificaciones@hotboat.cl
EMAIL_TO=admin@hotboat.cl,manager@hotboat.cl

# SendGrid (Alternativa)
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=notificaciones@hotboat.cl

# Resend (Alternativa HTTP)
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=notificaciones@hotboat.cl

# WhatsApp Business API (PRINCIPAL - Railway)
WHATSAPP_ENABLED=true
WHATSAPP_API_TOKEN=your_whatsapp_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id
WHATSAPP_VERIFY_TOKEN=your_verify_token
WHATSAPP_RECIPIENTS=+56912345678

# Monitor Configuration
CHECK_INTERVAL_APPOINTMENTS=60  # segundos
CHECK_INTERVAL_STOCK=300  # segundos
LOW_STOCK_THRESHOLD=5
CRITICAL_STOCK_THRESHOLD=2

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/automation.log

# Environment
ENVIRONMENT=development


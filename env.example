# Database Connection
DATABASE_URL=postgresql://user:password@localhost:5432/hotboat

# Telegram Bot (obtén el token de @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_IDS=123456789,987654321  # Separados por coma

# Email Configuration (SMTP)
EMAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=notificaciones@hotboat.cl
EMAIL_TO=admin@hotboat.cl,manager@hotboat.cl

# SendGrid (Alternativa)
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=notificaciones@hotboat.cl

# WhatsApp (Opcional - usa tu WhatsApp Business API)
WHATSAPP_ENABLED=false
WHATSAPP_API_TOKEN=your_whatsapp_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_RECIPIENTS=+56912345678,+56987654321

# Monitor Configuration
CHECK_INTERVAL_APPOINTMENTS=60  # segundos
CHECK_INTERVAL_STOCK=300  # segundos
LOW_STOCK_THRESHOLD=5
CRITICAL_STOCK_THRESHOLD=2

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/automation.log

# Environment
ENVIRONMENT=development

